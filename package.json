{
  "name": "golive-p2p",
  "version": "0.6.0-qt.4",
  "private": true,
  "type": "module",
  "description": "Native Qt C++ UI and P2P media engine. Node is used only for development checks.",
  "scripts": {
    "setup": "pwsh -NoProfile -File native/qt/setup.ps1",
    "dev": "pwsh -NoProfile -File native/qt/run.ps1",
    "native:setup": "pwsh -NoProfile -File native/windows/setup-sdk.ps1",
    "native:build": "pwsh -NoProfile -File native/windows/build-media.ps1",
    "build": "npm run build:win",
    "build:win": "npm run native:build && pwsh -NoProfile -File native/qt/build.ps1 -Package",
    "build:linux": "bash native/qt/build-linux.sh",
    "test": "pwsh -NoProfile -File native/qt/test.ps1",
    "test:integration": "node native/qt/smoke.mjs",
    "lint": "pwsh -NoProfile -File native/qt/lint.ps1",
    "typecheck": "pwsh -NoProfile -File native/qt/build.ps1",
    "verify:package": "node native/qt/verify-package.mjs"
  }
}
